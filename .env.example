# Copy this file to .env and replace the placeholder values.
# Keep .env and the service-account JSON file out of Git.

GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
GCP_REGION=us-central1
ARTIFACT_REPOSITORY=northgate-apps
CLOUD_RUN_SERVICE=northgate-kyc-chaser
GCP_CREDENTIALS_FILE=C:\secure\gcp\northgate-deployer.json
